# Dockerfile
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y python3 python3-pip tor build-essential cmake libssl-dev && rm -rf /var/lib/apt/lists/*
RUN pip3 install liboqs-python cryptography pysocks stem argon2-cffi
WORKDIR /hyperion
COPY . .
RUN pip3 install -e .
RUN mkdir -p /root/.hyperion
EXPOSE 9999
ENTRYPOINT ["python3", "/hyperion/main.py"]
CMD ["--help"]